# Lumen Builder — Vercel environment variables (Phase 22).
# Set in: Vercel project → Settings → Environment Variables (or `vercel env add`).
#
# The builder is a Vite app: only VITE_* vars are inlined into the client
# bundle. NEXT_PUBLIC_* aliases are documented for parity with the phase spec
# and any Next.js-hosted sibling apps; for THIS app use the VITE_* names.

# ── Public (browser) — safe to expose ───────────────────────────────────────
# Supabase project URL. Consumed by backend/supabase/src/facade.ts
# createBackend(env) via VITE_SUPABASE_URL + VITE_SUPABASE_ANON_KEY to
# auto-select the hosted backend.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Supabase anon public key (dashboard → Settings → API Keys).
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Phase-spec NEXT_PUBLIC_* equivalents (document both; set VITE_* for Vite):
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Edge function base URLs (used by hosted bindings / external tooling).
# Usually ${SUPABASE_URL}/functions/v1/<fn>.
PUBLISH_PIPELINE_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/publish-pipeline
ASSET_PIPELINE_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/asset-pipeline

# ── Server-only — NEVER expose to the browser ───────────────────────────────
# Service-role key bypasses RLS. Only set this if you add Vercel serverless
# functions of your own; the static SPA build does NOT need it and it must
# never appear in a VITE_*/NEXT_PUBLIC_* variable.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi... # server-only, do not prefix

# Lumen Engine — backend deploy environment (Phase 22).
# Copy to .env and fill in; NEVER commit the real file.
#
# Where to find each value — Supabase dashboard (https://supabase.com/dashboard):
#
# SUPABASE_URL
#   Project → Settings → Data API → "Project URL" (https://<ref>.supabase.co)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
#
# SUPABASE_ANON_KEY
#   Project → Settings → API Keys → "anon" "public" key. Safe for browsers.
SUPABASE_ANON_KEY=eyJhbGciOi...
#
# SUPABASE_SERVICE_ROLE_KEY
#   Project → Settings → API Keys → "service_role" key. SERVER ONLY — bypasses
#   RLS; never ship to the client. Used by deploy scripts, validation, and
#   as the bearer credential for the asset-pipeline edge function.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
#
# SUPABASE_JWT_SECRET
#   Project → Settings → API Keys → "JWT Secret". Used to verify/mint JWTs
#   locally (tests, tooling); the hosted edge functions get it automatically.
SUPABASE_JWT_SECRET=your-jwt-secret
#
# CRON_SECRET  (edge-function secret — set via `supabase secrets set`)
#   You generate this yourself (any strong random string). Shared between the
#   pg_cron `settle_payouts` job and the payouts edge function via the
#   `x-cron-secret` header. deploy-supabase.sh generates one if unset.
CRON_SECRET=generate-a-strong-random-string
#
# PAYOUT_THRESHOLD_CENTS  (edge-function secret for the payouts function)
#   Minimum accrued creator share before a payout row is scheduled. Default 2500 ($25).
PAYOUT_THRESHOLD_CENTS=2500
#
# SUPABASE_PROJECT_REF — needed by deploy-supabase.sh for `supabase link`.
#   Visible in the dashboard URL: app.supabase.com/project/<ref>
SUPABASE_PROJECT_REF=yourprojectref
#
# SUPABASE_ACCESS_TOKEN — personal access token for the CLI (alternative to
#   `supabase login`): https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_...
#
# SUPABASE_DB_URL (optional) — direct Postgres connection string, enables the
#   psql migration path and pg-level RLS/cron validation:
#   Project → Settings → Database → Connection string (direct, port 5432).
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
